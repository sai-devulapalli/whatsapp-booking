# Postgres (mapped to a non-default host port to avoid clashing with a locally
# installed Postgres/Redis on the standard ports)
DATABASE_URL="postgresql://whatsapp:whatsapp@localhost:55432/whatsapp_booking"

# Redis
REDIS_URL="redis://localhost:56379"

# Auth
JWT_SECRET="change-me-in-production"

# API
PORT=4000

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="change-me-webhook-verify-token"
WHATSAPP_APP_SECRET=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_GRAPH_API_VERSION="v20.0"
